<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>


	<appSettings>
		<add key="SessionsPath" value="C:\SensorSessions"/>
		<add key="L_threshold" value="50"/>
		<add key="RH_threshold" value="10"/>
		<add key="AQ_threshold" value="100"/>
		<add key="LogPath" value="invalid_row.log"/>
	</appSettings>


	<system.serviceModel>
		<bindings>
			<netTcpBinding>
				<binding name="SensorBinding"
						 transferMode="Streamed"
						 maxReceivedMessageSize="65536000"
						 receiveTimeout="00:10:00"
						 sendTimeout="00:10:00"
						 openTimeout="00:01:00"
						 closeTimeout="00:01:00" >
				</binding>
			</netTcpBinding>
		</bindings>
	


	<services>
		<service name ="Server.SensorService">
			<host>
				<baseAddresses>
					<add baseAddress="net.tcp://localhost:9001"/>
				</baseAddresses>
			</host>
			<endpoint
				address="Sensor"
				binding="netTcpBinding"
				bindingConfiguration="SensorBinding"
				contract="Common.ISensorService"/>
		</service>
	</services>
	
	</system.serviceModel>
</configuration>